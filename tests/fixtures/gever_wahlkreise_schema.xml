  <xsd:annotation>
    <xsd:documentation>
      <searchfield type="SearchFieldBoolean" Name="inaktiv" BoostFactor="1" Nrs="6"/>
      <searchfield type="SearchFieldText" Name="Name" BoostFactor="1" Nrs="5"/>
    </xsd:documentation>
  </xsd:annotation>
  <xsd:complexType name="Wahlkreis">
    <xsd:sequence>
      <xsd:element name="Name" type="xsd:string"/>
