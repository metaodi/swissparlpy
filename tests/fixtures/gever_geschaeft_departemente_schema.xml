<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.cmiag.ch/cdws/geschaeft" elementFormDefault="qualified" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:complexType name="DateTimeFieldType">
    <xsd:sequence minOccurs="0">
      <xsd:element name="Start" type="xsd:dateTime" nillable="true"/>
      <xsd:element name="End" type="xsd:dateTime" nillable="true"/>
      <xsd:element name="Text" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="Departement">
    <xsd:sequence>
      <xsd:element name="Name" type="xsd:string"/>
    </xsd:sequence>
    <xsd:attribute name="OBJ_GUID" type="xsd:string" use="required"/>
  </xsd:complexType>
  <xsd:complexType name="Mitglied">
    <xsd:sequence>
      <xsd:element name="Name" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="Gremium">
    <xsd:sequence>
      <xsd:element name="Name" type="xsd:string"/>
      <xsd:element name="Mitglieder">
        <xsd:complexType>
          <xsd:choice minOccurs="0" maxOccurs="unbounded">
            <xsd:element name="Mitglied" type="Mitglied"/>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
    <xsd:attribute name="OBJ_GUID" type="xsd:string" use="required"/>
  </xsd:complexType>
  <xsd:complexType name="Sitzung">
    <xsd:sequence>
      <xsd:element name="Titel" type="xsd:string"/>
    </xsd:sequence>
    <xsd:attribute name="OBJ_GUID" type="xsd:string" use="required"/>
  </xsd:complexType>
  <xsd:complexType name="Traktandum">
    <xsd:sequence>
      <xsd:element name="Titel" type="xsd:string"/>
      <xsd:element name="Sitzung">
        <xsd:complexType>
          <xsd:choice minOccurs="0" maxOccurs="1">
            <xsd:element name="Sitzung" type="Sitzung"/>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
    <xsd:attribute name="OBJ_GUID" type="xsd:string" use="required"/>
  </xsd:complexType>
  <xsd:complexType name="Geschaeft">
    <xsd:sequence>
      <xsd:element name="Titel" type="xsd:string"/>
      <xsd:element name="SitzungsEnde" type="DateTimeFieldType"/>
      <xsd:element name="FederfuehrendesDepartement">
        <xsd:complexType>
          <xsd:choice minOccurs="0" maxOccurs="1">
            <xsd:element name="Departement" type="Departement"/>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="MitbeteiligteDepartemente">
        <xsd:complexType>
          <xsd:choice minOccurs="0" maxOccurs="unbounded">
            <xsd:element name="Departement" type="Departement"/>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="VorberatendeKommission">
        <xsd:complexType>
          <xsd:choice minOccurs="0" maxOccurs="1">
            <xsd:element name="Gremium" type="Gremium"/>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="Federfuehrung">
        <xsd:complexType>
          <xsd:choice minOccurs="0" maxOccurs="1">
            <xsd:element name="Gremium" type="Gremium"/>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="Traktanden">
        <xsd:complexType>
          <xsd:choice minOccurs="0" maxOccurs="unbounded">
            <xsd:element name="Traktandum" type="Traktandum"/>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
    <xsd:attribute name="OBJ_GUID" type="xsd:string" use="required"/>
    <xsd:attribute name="SEQ" type="xsd:string" use="optional"/>
    <xsd:attribute name="IDX" type="xsd:string" use="optional"/>
  </xsd:complexType>
  <xsd:element name="Geschaeft" type="Geschaeft"/>
</xsd:schema>
